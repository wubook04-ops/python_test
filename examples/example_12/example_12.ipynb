   "source": [
    "import sympy as sp\n",
    "t = sp.symbols('t')\n",
    "x1, x2, x3 = sp.symbols('x1:4', cls = sp.Function)\n",
    "x = sp.Matrix([x1(t), x2(t), x3(t)])\n",
    "A = sp.Matrix([2, -3, 3],[4, -5, 3],[4, 4, 2])\n",
    "eq = x.diff(t) - A*x\n",
    "g = sp.dsolve(eq, ics = {x1(0):1, x2(0):2,x3(0):3})\n",
    "print(g)"
   ],
